{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "dataDir",
      "type": "promptString",
      "description": "Directory with the original game files (KONDOR.EXE, writable)",
      "default": "${env:HOME}/kondor/KONDOR"
    }
  ],
  "configurations": [
    {
      "name": "Kondor (debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/kondor",
      "args": [],
      "cwd": "${input:dataDir}",
      "environment": [{ "name": "KONDOR_DATA", "value": "${input:dataDir}" }],
      "MIMode": "gdb",
      "preLaunchTask": "build debug",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Kondor (debug, headless test)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/kondor",
      "args": [],
      "cwd": "${input:dataDir}",
      "environment": [
        { "name": "KONDOR_DATA", "value": "${input:dataDir}" },
        { "name": "KONDOR_HEADLESS", "value": "1" },
        { "name": "KONDOR_NOSOUND", "value": "1" },
        { "name": "KONDOR_FAST", "value": "1" },
        { "name": "KONDOR_SEED", "value": "1" },
        { "name": "KONDOR_MAXFRAMES", "value": "2000" }
      ],
      "MIMode": "gdb",
      "preLaunchTask": "build debug",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Kondor (release, run without debugging)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/kondor",
      "args": [],
      "cwd": "${input:dataDir}",
      "environment": [{ "name": "KONDOR_DATA", "value": "${input:dataDir}" }],
      "MIMode": "gdb",
      "preLaunchTask": "build release"
    }
  ]
}
